# Русские названия и пояснения оружия плагина basic-set-sample.
# Ключи: weapon-<id>; тексты — собственные пересказы, не текст книг SJG.

weapon-broadsword = Палаш
    .description =
        Сбалансированный одноручный меч: рубящий замах или тычок затупленным остриём, оба на длину руки. Парирует без штрафа.

weapon-small-knife = Малый нож
    .description =
        Короткий клинок: колоть вплотную или полоснуть на короткой дистанции. Из-за малого размера парирует со штрафом.

weapon-large-knife = Большой нож
    .description =
        Более тяжёлый боевой нож: укол сильнее, режущий удар пригоден для боя; парирует со штрафом.

weapon-punch = Удар рукой
    .description =
        Удар кулаком. Используется «Драка», если она изучена, иначе просто ЛВ. Очень умелые драчуны (ЛВ+2 и выше) бьют сильнее: +1 к урону за кубик.

weapon-kick = Удар ногой
    .description =
        Удар ногой: сильнее удара рукой, но им нельзя парировать. Используется приём «Пинок», если он куплен, иначе «Драка»−2 или ЛВ−2. Бонус к урону от «Драки» действует и здесь.
